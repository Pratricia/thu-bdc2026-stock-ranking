# 和 TensorBoard events 日志
# ============================================================
/model/
/factor_artifacts/
/temp/
/output/
/output-docker/
/output-offline/
# 历史遗留：误放在源码目录下的模型输出
/code/src/model/

# ============================================================
# 打包文件（比赛提交包，单个 >600MB）
# 注意：必须同时写 *.tar.gz，只写 *.tar 匹配不到
# ============================================================
*.tar
*.tar.gz
*.tgz
*.zip

