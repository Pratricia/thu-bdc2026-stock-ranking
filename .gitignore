# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
wheels/
.venv/
venv/

# ============================================================
# 数据（体积过大，不入库）
# 获取方式见 README「数据」一节：baostock 公开 API 重新拉取
# ============================================================
/data/*.csv
!/data/hs300_stock_list.csv
/data/datasets/
/data/manifests/
/data/data_manifest_dataset_build.json

# ============================================================
# 训练产物 / 推理输出
# 只提交最终模型 model/60_158+39/ 的推理必需文件（约 1.4MB）：
#   best_model.pth / scaler.pkl / config.json / active_factors.json
#   prior_graph_adj.npy / stock_industry_idx.npy / best_strategy.json 等
# 以下产物单个 90~260MB，超出 GitHub 单文件 100MB 上限，不入库：
#   factor_artifacts/ 下的因子快照 CSV、log/ 下的 TensorBoard events
#   各 seed / 消融实验的模型副本
# ============================================================
/model/*
!/model/60_158+39/
/model/60_158+39/factor_artifacts/
/model/60_158+39/log/
# 数据源清单：记录的是本机绝对路径，换机器无意义
/model/60_158+39/data_manifest.json
/model/60_158+39/data_manifest_predict.json

/factor_artifacts/
/temp/
/output/
/output-docker/
/output-offline/
# 历史遗留：误放在源码目录下的模型输出
/code/src/model/

# ============================================================
# 打包文件（比赛提交包，单个 >600MB）
# 注意：必须同时写 *.tar.gz，只写 *.tar 匹配不到
# ============================================================
*.tar
*.tar.gz
*.tgz
*.zip

